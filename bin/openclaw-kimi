#!/usr/bin/env bun
// openclaw-kimi — point OpenClaw at Kimi K2.6 on OpenRouter's free tier.
//
// Why this backend: Anthropic's April 2026 policy excludes third-party
// harnesses (OpenClaw by name) from Claude subscription coverage and enforces
// it server-side. Routing Molly's gateway through the Max seat risks the seat
// everything else here runs on. Kimi K2.6 free costs $0 and carries no such
// restriction. Full reasoning: docs/OPENCLAW.md.
//
// Idempotent. Patches only agents.defaults.model, backs up before writing, and
// leaves every other key in the config untouched.

import { $ } from "bun"
import { existsSync } from "node:fs"
import { homedir } from "node:os"
import { join } from "node:path"

const MODEL = "openrouter/moonshotai/kimi-k2.6:free"
const CONFIG_DIR = join(homedir(), ".openclaw")
const CONFIG = join(CONFIG_DIR, "openclaw.json")

function die(msg: string): never {
  console.error(`openclaw-kimi: ${msg}`)
  process.exit(1)
}

if (!Bun.which("openclaw")) die("openclaw not installed. Run: bun install -g openclaw")

const nodeMajor = Number((Bun.spawnSync(["node", "--version"]).stdout.toString().trim() || "v0").slice(1).split(".")[0])
if (!(nodeMajor >= 22)) die(`node >= 22 required (found ${nodeMajor || "none"})`)

// `openclaw setup --baseline` writes the config itself, so this runs first and
// the patch below then applies to whatever it produced.
if (!existsSync(CONFIG_DIR)) {
  console.log("Creating baseline workspace…")
  await $`openclaw setup --baseline`
}

if (!existsSync(CONFIG)) die(`expected ${CONFIG} after baseline setup, but it is missing`)

const raw = await Bun.file(CONFIG).text()
let config: Record<string, any>
try {
  config = JSON.parse(raw)
} catch {
  // A hand-edited config may be JSON5, which cannot be safely round-tripped.
  console.log(`${CONFIG} is not plain JSON — leaving it alone.`)
  console.log(`\nSet this by hand:\n  agents.defaults.model.primary = "${MODEL}"`)
  process.exit(0)
}

const current = config.agents?.defaults?.model?.primary
if (current === MODEL) {
  console.log(`Already on ${MODEL} — nothing to do.`)
  process.exit(0)
}

// Never silently retarget a backend someone else chose.
if (current && current !== MODEL) {
  console.log(`Config already points at "${current}" — leaving it alone.`)
  console.log(`\nTo switch to free Kimi:\n  agents.defaults.model.primary = "${MODEL}"`)
  process.exit(0)
}

await Bun.write(`${CONFIG}.bak`, raw)

config.agents ??= {}
config.agents.defaults ??= {}
config.agents.defaults.model = { ...(config.agents.defaults.model ?? {}), primary: MODEL }

await Bun.write(CONFIG, JSON.stringify(config, null, 2) + "\n")

console.log(`Set agents.defaults.model.primary → ${MODEL}`)
console.log(`Backup: ${CONFIG}.bak`)
console.log(`
Kimi K2.6 free: $0 · 262K context · 20 req/min · 50/day
(1000/day permanently after a one-time $10 OpenRouter credit purchase)

Next, once:
  openclaw onboard --auth-choice openrouter-oauth   # browser sign-in, stores the key
  openclaw channels login                           # pick Telegram / WhatsApp / etc
  openclaw gateway --port 18789                     # run it`)
